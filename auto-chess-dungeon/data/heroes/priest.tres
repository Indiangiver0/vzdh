script = ExtResource("1")
id = "priest"
display_name = "Жрица"
hp = 65
damage = 7
armor = 1
ability_description = "Лекарь · каждый третий боевой тик лечит самого раненого союзника. Пока жива и не под безмолвием, весь отряд получает на 25% меньше урона яда. Ауры не складываются; с алхимиками защита ограничена 50%. Уязвима к атакам в тыл."
